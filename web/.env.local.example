NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 運営者情報 (/about/)
NEXT_PUBLIC_OPERATOR_NAME=kakera-apps
NEXT_PUBLIC_CONTACT_URL=
# {url} = 遷移先URL(エンコード済み) / {keyword} = 検索キーワード(エンコード済み)
# メルカリアンバサダー例: https://jp.mercari.com/search?keyword={keyword}&status=sold_out%7Ctrading&afid=YOUR_AFID
NEXT_PUBLIC_MERCARI_AFFILIATE_TEMPLATE=
# もしもアフィリエイト(楽天)例: https://af.moshimo.com/af/c/click?a_id=XXXX&p_id=54&pc_id=54&pl_id=616&url={url}
NEXT_PUBLIC_RAKUTEN_AFFILIATE_TEMPLATE=
# もしもアフィリエイト(Amazon)例: https://af.moshimo.com/af/c/click?a_id=XXXX&p_id=170&pc_id=185&pl_id=4062&url={url}
NEXT_PUBLIC_AMAZON_AFFILIATE_TEMPLATE=
# Amazonアソシエイト直接タグ (テンプレート未設定時)
NEXT_PUBLIC_AMAZON_TAG=
# 宅配買取ASPの広告リンクURL
NEXT_PUBLIC_TAKUHAI_KAITORI_URL=
# Google AdSense (例: ca-pub-xxxxxxxxxxxxxxxx)
NEXT_PUBLIC_ADSENSE_CLIENT=
# DBパス変更時のみ
# ZUKAN_DB_PATH=

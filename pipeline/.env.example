# Gemini (generator.py) https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 楽天ウェブサービス (任意) https://webservice.rakuten.co.jp/
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
# 新API基盤(openapi.rakuten.co.jp)を使う場合のみ

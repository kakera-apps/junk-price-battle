# Yahoo!ショッピングAPI v3 (任意・無料) https://developer.yahoo.co.jp/
YAHOO_CLIENT_ID=
# バリューコマース経由でアフィリエイト化する場合のみ
YAHOO_VC_SID=
YAHOO_VC_PID=

# eBay (将来の海外相場自動取得用・現状未使用)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Wikimedia: CC BY-SA も許可する場合は 1 (既定は CC0/PD/CC BY のみ)
WIKIMEDIA_ALLOW_SA=0
